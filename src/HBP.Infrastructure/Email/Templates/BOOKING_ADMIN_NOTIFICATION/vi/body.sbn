<div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:18px;letter-spacing:2px;text-transform:uppercase;color:#a98b5f;">Yêu cầu đặt phòng mới</div>
<h1 class="email-title" style="margin:8px 0 14px;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:42px;font-weight:400;color:#26221b;">Có khách hàng đang chờ bạn</h1>
<p style="margin:0 0 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#655e54;">Một yêu cầu đặt phòng mới vừa được gửi tới {{ company_name }}. Vui lòng kiểm tra và liên hệ khách hàng sớm.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:separate;background-color:#faf7f1;border:1px solid #e9e0d2;border-radius:12px;">
  <tr><td colspan="2" style="padding:18px 22px;border-bottom:1px solid #e9e0d2;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7c7468;">MÃ YÊU CẦU&nbsp;&nbsp;<strong style="font-size:15px;color:#26221b;letter-spacing:1px;">{{ reference_code | html.escape }}</strong></td></tr>
  <tr><td class="detail-label" style="width:38%;padding:16px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Khách hàng</td><td style="padding:16px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;"><strong>{{ full_name | html.escape }}</strong></td></tr>
  <tr><td style="padding:8px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Liên hệ</td><td style="padding:8px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;"><a href="mailto:{{ email }}" style="color:#8a6e48;text-decoration:none;">{{ email | html.escape }}</a><br>{{ phone_number | html.escape }}</td></tr>
  <tr><td style="padding:8px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Thời gian lưu trú</td><td style="padding:8px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;">{{ check_in_date }} → {{ check_out_date }}</td></tr>
  <tr><td style="padding:8px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Phòng</td><td style="padding:8px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;">{{ number_of_rooms }} phòng{{ if room_type_name }} · {{ room_type_name | html.escape }}{{ end }}</td></tr>
  <tr><td style="padding:8px 10px 18px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Số khách</td><td style="padding:8px 22px 18px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;">{{ adults }} người lớn · {{ children }} trẻ em</td></tr>
</table>
{{ if customer_message }}<div style="margin-top:22px;padding:18px 20px;border-left:3px solid #a98b5f;background-color:#f8f5ef;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:23px;color:#544e45;"><strong style="display:block;margin-bottom:6px;color:#26221b;">Lời nhắn của khách</strong>{{ customer_message | html.escape }}</div>{{ end }}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:28px;"><tr><td style="border-radius:6px;background-color:#26221b;"><a href="{{ website_url }}/admin/bookings/{{ related_entity_id }}" style="display:inline-block;padding:14px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;letter-spacing:.5px;color:#ffffff;text-decoration:none;">Xem yêu cầu đặt phòng&nbsp; →</a></td></tr></table>
