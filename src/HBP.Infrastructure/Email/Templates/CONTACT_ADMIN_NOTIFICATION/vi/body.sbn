<div style="font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:18px;letter-spacing:2px;text-transform:uppercase;color:#a98b5f;">Liên hệ mới từ website</div>
<h1 class="email-title" style="margin:8px 0 14px;font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:42px;font-weight:400;color:#26221b;">Khách hàng muốn kết nối</h1>
<p style="margin:0 0 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#655e54;">Bạn vừa nhận được một nội dung liên hệ mới. Thông tin chi tiết được tổng hợp bên dưới.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:separate;background-color:#faf7f1;border:1px solid #e9e0d2;border-radius:12px;">
  <tr><td colspan="2" style="padding:18px 22px;border-bottom:1px solid #e9e0d2;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">MÃ LIÊN HỆ&nbsp;&nbsp;<strong style="font-size:15px;color:#26221b;letter-spacing:1px;">{{ reference_code | html.escape }}</strong></td></tr>
  <tr><td class="detail-label" style="width:38%;padding:16px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Khách hàng</td><td style="padding:16px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;"><strong>{{ full_name | html.escape }}</strong></td></tr>
  <tr><td style="padding:8px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Email</td><td style="padding:8px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;"><a href="mailto:{{ email }}" style="color:#8a6e48;text-decoration:none;">{{ email | html.escape }}</a></td></tr>
  <tr><td style="padding:8px 10px 8px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Điện thoại</td><td style="padding:8px 22px 8px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;">{{ phone_number | html.escape }}</td></tr>
  <tr><td style="padding:8px 10px 18px 22px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#7c7468;">Chủ đề</td><td style="padding:8px 22px 18px 10px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#26221b;">{{ subject | html.escape }}</td></tr>
</table>
<div style="margin-top:22px;padding:20px;border-left:3px solid #a98b5f;background-color:#f8f5ef;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:23px;color:#544e45;"><strong style="display:block;margin-bottom:7px;color:#26221b;">Nội dung tin nhắn</strong>{{ message | html.escape }}</div>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:28px;"><tr><td style="border-radius:6px;background-color:#26221b;"><a href="{{ website_url }}/admin/contacts/{{ related_entity_id }}" style="display:inline-block;padding:14px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;color:#ffffff;text-decoration:none;">Mở trang quản trị&nbsp; →</a></td></tr></table>
